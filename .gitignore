# ----------------------------------------------------------------------------
# Global .gitignore for YKP Hermez AI Command Center
# ----------------------------------------------------------------------------

# Environment / secrets — never commit real values.
.env
.env.*.local
.env.prod
.env.test
.env.smoke
!.env.example
!.env.prod.example

# Service-account keys and certs
gcp-service-account*.json
google-service-account*.json
service-account*.json
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der

# Node / JS build artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
pnpm-lock.yaml
bun.lockb

# Next.js / TypeScript build artifacts
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts
*.log
coverage/
.nyc_output
.turbo

# Python / MT5 bridge
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.venv/
venv/
ENV/
env/

# Local dev / OS
.DS_Store
Thumbs.db
*.swp
*.swo
*.swn
*.bak
*.tmp
*.orig

# Playwright / Claude / ephemeral state
.claude/
.playwright-mcp/
.playwright-cache/
.workflow/tmp/
*.lock

# Large / binary / generated assets that should not live in git
*.zip
*.tar.gz
*.rar
*.7z
*.psd
*.mp4
*.mov

# Generated outputs that should be treated as ephemeral
simulator/out.csv
simulator/out.png
simulator/out_signals.csv
indicators/**/*.json

# Backup demo is intentionally excluded from source control; it is a stale
# snapshot kept only for local reference and is 3.2 GB.
.backup_ykp-demo_2026-07-03/

.vercel
.env*
