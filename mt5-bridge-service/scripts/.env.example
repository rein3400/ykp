# YKP MT5 Bridge — local dev env template.
# Copy this file to .env (same directory) and fill in real values.
# .env is gitignored — never commit real credentials.

# MetaTrader 5 demo account (from Exness or MetaQuotes portal).
MT5_LOGIN=your_demo_login
MT5_PASSWORD=your_demo_password
MT5_SERVER=Exness-MT5Trial7

# Optional: explicit terminal64.exe path (required when multiple MT5 builds installed).
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5 EXNESS\terminal64.exe

# Bearer token required by orchestrator at MT5_BRIDGE_TOKEN env.
# Generate with: [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
MT5_BRIDGE_TOKEN=replace_with_64_hex_token