# Hermez AI chat bot — Telegram + LLM
# Copy to .env and fill real values. Never commit the real .env.

NODE_ENV=production

# Telegram bot (dedicated AI chat bot)
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to chat (owner whitelist)
TELEGRAM_OWNER_IDS=
# Set "true" to let ANY Telegram user chat
TELEGRAM_OPEN_ACCESS=true
TELEGRAM_BOT_SECRET=

# LLM (Ollama Cloud, OpenAI-compatible)
LLM_API_KEY=
LLM_BASE_URL=https://ollama.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_VISION_MODEL=minimax-m3
LLM_LITE_MODEL=deepseek-v4-flash

# Module base URLs
YKP_FINANCE_URL=
YKP_HR_URL=
YKP_WAREHOUSE_URL=
YKP_OPS_URL=
YKP_INVESTOR_URL=

HERMEZ_DATA_DIR=./data

# Force IPv4-first DNS (VPS without IPv6)
NODE_OPTIONS=--dns-result-order=ipv4first
