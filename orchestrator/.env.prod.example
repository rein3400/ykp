# Production env template — copy to .env.prod and fill real values
# NEVER commit .env.prod (gitignored)
NODE_ENV=production
APP_PORT=3001
APP_HOST=0.0.0.0
LOG_LEVEL=info

# Postgres — use a strong password; same values passed via compose
DATABASE_URL=postgres://ykp:REPLACE_ME_POSTGRES_PASSWORD@postgres:5432/ykp_orchestrator

# Redis
REDIS_URL=redis://redis:6379

# Telegram — reuse bot @justatestermaybot, owner chat 5721500978
TELEGRAM_BOT_TOKEN=REPLACE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_OWNER_CHAT_ID=5721500978
TELEGRAM_WEBHOOK_MODE=true
TELEGRAM_WEBHOOK_SECRET=REPLACE_ME_64HEX
TELEGRAM_APPROVER_CHAT_IDS=

# TradingView webhook
TRADINGVIEW_WEBHOOK_SECRET=REPLACE_ME_64HEX

# AI providers
OPENAI_API_KEY=REPLACE_ME_OPENAI_API_KEY
DEFAULT_AI_MODEL=gpt
LOCAL_AI_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://ollama:11434

# Vector / RAG
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=hermes_knowledge
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
KNOWLEDGE_ROOT=/app/Hermes_Knowledge

# News (stub fail-safe until provider integrated)
NEWS_PROVIDER=stub
NEWS_WINDOW_MIN=30
NEWS_API_KEY=
NEWS_FILTER_ENABLED=true   # set false for smoke/dev; true in prod means stub blocks trades

# Cloudflare ingress
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_ME_CLOUDFLARE_TUNNEL_TOKEN
PUBLIC_BASE_URL=https://hermes.REPLACE_ME_DOMAIN
CORS_ORIGIN=https://hermes.REPLACE_ME_DOMAIN
API_KEY=REPLACE_ME_64HEX

# Trading scoring + risk (ICT_TRADING_STRATEGY.md §4 / §8)
SCORE_THRESHOLD=80
SESSION_STRICT=true
RISK_ACCOUNT_USD=10000
RISK_PCT_PER_TRADE=1
RR_TARGET=3

# Approval / execution
APPROVAL_TTL_MIN=30

# MT5 bridge (runs on Windows host via NSSM, not in container)
MT5_BRIDGE_URL=http://host.docker.internal:8765
MT5_BRIDGE_TOKEN=REPLACE_ME_64HEX
MT5_LOGIN=REPLACE_ME_MT5_LOGIN
MT5_PASSWORD=REPLACE_ME_MT5_PASSWORD
MT5_SERVER=REPLACE_ME_MT5_SERVER
MT5_BRIDGE_TIMEOUT_MS=5000
MT5_MAX_CONCURRENT_TRADES=3
MT5_BREAKER_THRESHOLD=3

# Workers
DAILY_REPORT_CRON=30 23 * * *
BACKUP_CRON=0 3 * * *
MONITOR_INTERVAL_SECONDS=60
BACKUP_DIR=/var/lib/ykp/backups
SETUP_TTL_MINUTES=240
