# YKP AI Orchestrator env (copy to .env, fill real values for prod)
NODE_ENV=development
APP_PORT=3001
APP_HOST=0.0.0.0
LOG_LEVEL=info

# Postgres
DATABASE_URL=postgres://ykp:ykp@localhost:5432/ykp_orchestrator

# Redis
REDIS_URL=redis://localhost:6379

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# TradingView webhook
TRADINGVIEW_WEBHOOK_SECRET=

# AI providers
OPENAI_API_KEY=
DEFAULT_AI_MODEL=gpt
LOCAL_AI_MODEL=qwen
OLLAMA_BASE_URL=http://ollama:11434

# Cloudflare (prod only, optional locally)
CLOUDFLARE_TUNNEL_TOKEN=

# Workers
DAILY_REPORT_CRON=30 23 * * *
BACKUP_CRON=0 3 * * *
MONITOR_INTERVAL_SECONDS=60
BACKUP_DIR=/var/lib/ykp/backups

# Setup state TTL (minutes) — SRI ICT state expiry
SETUP_TTL_MINUTES=240