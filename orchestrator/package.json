{
  "name": "ykp-orchestrator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "YKP AI Orchestrator / Hermes — modular orchestration layer",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "worker": "tsx watch src/worker-entry.ts",
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.2.0",
    "@qdrant/js-client-rest": "^1.18.0",
    "bullmq": "^5.52.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.2",
    "dotenv-expand": "^12.0.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.1",
    "grammy": "^1.36.0",
    "ioredis": "^5.6.1",
    "marked": "^18.0.5",
    "nanoid": "^5.1.5",
    "openai": "^5.12.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.1.1",
    "postgres": "^3.4.5",
    "slugify": "^1.6.9",
    "youtube-transcript": "^1.3.1",
    "youtubei.js": "^17.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
