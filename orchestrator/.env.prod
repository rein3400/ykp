# Scoring + risk
SCORE_THRESHOLD=80
SESSION_STRICT=false
RISK_ACCOUNT_USD=10000
RISK_PCT_PER_TRADE=0.5
RR_TARGET=2

# Approval
APPROVAL_TTL_MIN=30

# MT5 bridge — Exness demo account
MT5_BRIDGE_URL=http://host.docker.internal:8765
