# AI providers
OPENAI_API_KEY=REPLACE_ME_OPENAI_API_KEY
DEFAULT_AI_MODEL=qwen
LOCAL_AI_MODEL=qwen2.5:7b
# Ollama cloud endpoint — example; replace with your subscription URL
OLLAMA_BASE_URL=https://ollama.com
# Required for Ollama cloud. Leave blank for local Ollama.
OLLAMA_API_KEY=REPLACE_ME_OLLAMA_CLOUD_KEY

# Vector / RAG
EMBED_PROVIDER=ollama
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=768
EMBED_FALLBACK_MODEL=nomic-embed-text

# News — fail-safe stub mode for prod (block trades when cannot verify calendar)
NEWS_PROVIDER=stub
NEWS_WINDOW_MIN=30
NEWS_API_KEY=
NEWS_FILTER_ENABLED=false

# Cloudflare Tunnel — placeholder until tunnel created in CF dashboard
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_ME_CLOUDFLARE_TUNNEL_TOKEN
