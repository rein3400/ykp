# Local smoke-test env (NOT for prod)
NODE_ENV=development
APP_PORT=3001
APP_HOST=0.0.0.0
LOG_LEVEL=info

# Postgres/Redis/Qdrant — overridden by compose env to container hosts
POSTGRES_USER=ykp
POSTGRES_PASSWORD=ykp
POSTGRES_DB=ykp_orchestrator
DATABASE_URL=postgres://ykp:ykp@postgres:5432/ykp_orchestrator
REDIS_URL=redis://redis:6379
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=hermes_knowledge
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
KNOWLEDGE_ROOT=/app/Hermes_Knowledge

NEWS_PROVIDER=stub
NEWS_WINDOW_MIN=30
NEWS_FILTER_ENABLED=false

SCORE_THRESHOLD=80
SESSION_STRICT=false
RISK_ACCOUNT_USD=10000
RISK_PCT_PER_TRADE=0.5
RR_TARGET=2

APPROVAL_TTL_MIN=30
TELEGRAM_APPROVER_CHAT_IDS=

# MT5 bridge (Phase 3) — uncomment for real Python bridge on Windows VM
# MT5_BRIDGE_URL=http://mt5-bridge:8765
# MT5_BRIDGE_TOKEN=local-test
MT5_BRIDGE_TIMEOUT_MS=5000
MT5_MAX_CONCURRENT_TRADES=3
MT5_BREAKER_THRESHOLD=3

# Dummy secrets (smoke test only — replace with real for actual signals)
TELEGRAM_BOT_TOKEN=0000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TELEGRAM_OWNER_CHAT_ID=0
TELEGRAM_WEBHOOK_SECRET=local-smoke
TRADINGVIEW_WEBHOOK_SECRET=local-smoke

OPENAI_API_KEY=sk-smoke
OLLAMA_BASE_URL=http://ollama:11434

DEFAULT_AI_MODEL=gpt
LOCAL_AI_MODEL=qwen

DAILY_REPORT_CRON=30 23 * * *
BACKUP_CRON=0 3 * * *
MONITOR_INTERVAL_SECONDS=60
BACKUP_DIR=/var/lib/ykp/backups
SETUP_TTL_MINUTES=240