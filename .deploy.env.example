# Copy to .deploy.env and fill in every value (never commit .deploy.env).
#
#   cp .deploy.env.example .deploy.env && $EDITOR .deploy.env && ./deploy.sh
#
# ---------------------------------------------------------------- Coolify
COOLIFY_URL="http://187.127.124.37:8000"        # target Coolify instance
COOLIFY_TOKEN=""                                # Settings -> API -> root token
VPS_IP="187.127.124.37"                          # public IP of the Coolify host

# ---------------------------------------------------------------- git
GIT_REPO="https://github.com/rein3400/ykp.git"
GIT_BRANCH="main"

# ---------------------------------------------------------------- Google Sheets (service account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""            # literal \n, one line: -----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n
