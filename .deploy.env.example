# deploy.sh configuration — YKP V1 family (Coolify).
# Usage: cp .deploy.env.example .deploy.env && $EDITOR .deploy.env && ./deploy.sh
# Everything marked REQUIRED must be filled with real values; OPTIONAL defaults are safe.

# ── Build scheduling (leave 1 on <=2 vCPU / <8 GB RAM: builds run one at a time) ──
DEPLOY_SEQUENTIAL=1
# Permanent domain base (opsional tapi disarankan): app dapat subdomain <role>.<DOMAIN_BASE>
# dan sslip tetap dilampirkan sebagai fallback. Contoh: DOMAIN_BASE=ykp.my.id
DOMAIN_BASE=
# Safe migration default: no new scheduled tasks while old VPS remains active.
# After verified cutover and old jobs are disabled, set 0 and rerun to provision jobs.
# Existing tasks are NOT disabled by this flag.
MIGRATION_MODE=1
# Run deploy.sh ON the target VPS only. Confirm docker context targets that VPS.
TARGET_DOCKER_LOCAL=1

# ── REQUIRED: Coolify + target ──────────────────────────────────────────────
COOLIFY_URL=http://<vps>:8000          # Coolify dashboard URL (no trailing slash)
COOLIFY_TOKEN=<coolify-api-token>      # Coolify API root token
VPS_IP=<vps-ip>                        # dashes ok: 187-127-124-37 also fine

# ── REQUIRED: persistent secrets (rotate never on re-run; keep them saved) ──
HUB_SESSION_SECRET=                    # >= 32 chars
SESSION_HUB=                           # >= 32 chars
SESSION_OWNER=                         # >= 32 chars
SESSION_HR=                            # >= 32 chars
SESSION_FINANCE=                       # >= 32 chars
SESSION_WAREHOUSE=                     # >= 32 chars
SESSION_INVESTOR=                      # >= 32 chars
SESSION_OPS=                           # >= 32 chars
CRON_HR=                               # >= 32 chars (HR notify cron secret)
CRON_FINANCE=                          # >= 32 chars
CRON_WAREHOUSE=                        # >= 32 chars
CRON_INVESTOR=                         # >= 32 chars
CRON_OWNER=                            # >= 32 chars
ERP_SSO_SECRET=                        # >= 32 chars (legacy owner→module SSO; UI token links disabled)
FINANCE_NOTIFY_SECRET=                 # >= 32 chars (Finance ↔ HR payroll handoff secret)

# ── REQUIRED: Telegram (shared HR bot) ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=                    # HR bot token (@BotFather)
TELEGRAM_CHAT_ID=                      # owner broadcast chat
TELEGRAM_WEBHOOK_SECRET=               # >= 32 chars (HR Telegram webhook header)
TELEGRAM_BOT_SECRET=                   # >= 32 chars (bot ↔ app routes)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=     # e.g. YKPHermezBot

# ── REQUIRED: Google service account (Sheets backend, all modules) ──────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=          # service account e-mail
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=    # PRIVATE KEY with \n escapes, single line
YKP_HR_SPREADSHEET_ID=
YKP_FINANCE_SPREADSHEET_ID=
YKP_WAREHOUSE_SPREADSHEET_ID=
YKP_INVESTOR_SPREADSHEET_ID=
YKP_OPS_SPREADSHEET_ID=

# ── OPTIONAL: SMTP (slip gaji) — can also be set later in HR > Pengaturan Email
SMTP_HOST=                             # e.g. smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=                             # e.g. ykp.erp@gmail.com
SMTP_PASS=                             # Gmail App Password (NOT the Google password)
SMTP_FROM=                             # defaults to SMTP_USER

# ── OPTIONAL: dedicated Ops Telegram bot (menu/insiden/briefing webhook)
TELEGRAM_OPS_BOT_TOKEN=                # dedicated bot only; automatic activation refuses HR/shared token
TELEGRAM_OPS_BOT_USERNAME=ykp_operasional_bot
TELEGRAM_OPS_WEBHOOK_SECRET=           # >= 32 chars; required to register /api/ops/telegram/webhook

# ── OPTIONAL: Moka realtime per-outlet credentials (empty = pull sync only)
MOKA_SYNC_SECRET=                      # >= 32 chars
MOKA_OUTLETS=SEKARPIZZA_TIRTODIPURAN,FUNKYDAK_COLOMBO,SUBURBUNS_COLOMBO
MOKA_OUTLET_MAP='{"SEKARPIZZA_TIRTODIPURAN":"OL-012","FUNKYDAK_COLOMBO":"OL-011","SUBURBUNS_COLOMBO":"OL-013"}'
MOKA_SEKARPIZZA_TIRTODIPURAN_CLIENT_ID=
MOKA_SEKARPIZZA_TIRTODIPURAN_CLIENT_SECRET=
MOKA_SEKARPIZZA_TIRTODIPURAN_OUTLET_ID=
MOKA_FUNKYDAK_COLOMBO_CLIENT_ID=
MOKA_FUNKYDAK_COLOMBO_CLIENT_SECRET=
MOKA_FUNKYDAK_COLOMBO_OUTLET_ID=
MOKA_SUBURBUNS_COLOMBO_CLIENT_ID=
MOKA_SUBURBUNS_COLOMBO_CLIENT_SECRET=
MOKA_SUBURBUNS_COLOMBO_OUTLET_ID=

# ── OPTIONAL: ops AI assistant (empty = AI disabled)
OPENAI_API_KEY=
AI_MODEL=openai/gpt-4o-mini
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_HTTP_REFERER=
OPENAI_APP_TITLE=