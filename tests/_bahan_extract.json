    "Petunjuk": [
      {
        "row": 2,
        "cells": [
          "",
          "SISTEM KONTROL BAHAN BAKU — PT YKP"
        ]
      },
      {
        "row": 3,
        "cells": [
          "",
          "Template Form F1–F5  |  Versi 1.0  |  Untuk operasional outlet F&B YKP Group"
        ]
      },
      {
        "row": 5,
        "cells": [
          "",
          "CARA PAKAI"
        ]
      },
      {
        "row": 7,
        "cells": [
          "",
          "1. Upload file ini ke Google Drive PT YKP, lalu klik kanan → 'Open with Google Sheets' untuk versi cloud."
        ]
      },
      {
        "row": 8,
        "cells": [
          "",
          "2. Atau cetak (print) tiap sheet untuk dipakai manual di outlet di hari pertama."
        ]
      },
      {
        "row": 9,
        "cells": [
          "",
          "3. Tiap outlet pegang 1 file copy (rename: 'Stok_NamaOutlet_Bulan.xlsx')."
        ]
      },
      {
        "row": 10,
        "cells": [
          "",
          "4. PIC Stok mengisi sel berwarna KUNING (input). Sel HIJAU dihitung otomatis (jangan diedit)."
        ]
      },
      {
        "row": 11,
        "cells": [
          "",
          "5. Tutup buku tiap malam jam 22:00. Kirim screenshot Sheet F5 ke WA grup 'Closing Harian YKP'."
        ]
      },
      {
        "row": 13,
        "cells": [
          "",
          "LEGENDA WARNA"
        ]
      },
      {
        "row": 14,
        "cells": [
          "",
          "   • Kuning  = Sel input (diisi manual oleh PIC Stok)"
        ]
      },
      {
        "row": 15,
        "cells": [
          "",
          "   • Hijau    = Sel otomatis (rumus, jangan diubah)"
        ]
      },
      {
        "row": 16,
        "cells": [
          "",
          "   • Merah    = Indikator selisih > toleransi (alert)"
        ]
      },
      {
        "row": 18,
        "cells": [
          "",
          "DAFTAR FORM"
        ]
      },
      {
        "row": 19,
        "cells": [
          "",
          "   F1  Penerimaan Barang        — diisi saat barang datang dari supplier/gudang pusat"
        ]
      },
      {
        "row": 20,
        "cells": [
          "",
          "   F2  Kartu Stok Gudang         — 1 baris per transaksi keluar-masuk per item"
        ]
      },
      {
        "row": 21,
        "cells": [
          "",
          "   F3  Bon Pemakaian Dapur     — wajib tiap kali bahan keluar dari gudang outlet"
        ]
      },
      {
        "row": 22,
        "cells": [
          "",
          "   F4  Waste / Kerusakan         — wajib foto, tanpa foto = tidak diakui"
        ]
      },
      {
        "row": 23,
        "cells": [
          "",
          "   F5  Stock Opname Harian     — closing tiap malam, kirim ke owner"
        ]
      },
      {
        "row": 24,
        "cells": [
          "",
          "   Master Item                          — daftar 5–10 item kritikal yang dipantau"
        ]
      },
      {
        "row": 26,
        "cells": [
          "",
          "ATURAN EMAS"
        ]
      },
      {
        "row": 27,
        "cells": [
          "",
          "   1. Tidak ada tanda tangan = barang tidak diterima."
        ]
      },
      {
        "row": 28,
        "cells": [
          "",
          "   2. Tidak ada bon F3 = bahan tidak boleh keluar dari gudang."
        ]
      },
      {
        "row": 29,
        "cells": [
          "",
          "   3. Tidak ada foto F4 = waste tidak diakui (jadi tanggung jawab PIC)."
        ]
      },
      {
        "row": 30,
        "cells": [
          "",
          "   4. Tidak ada closing F5 = outlet tidak boleh buka besok."
        ]
      },
      {
        "row": 31,
        "cells": [
          "",
          "   5. Selisih > 5% per item = wajib investigasi 24 jam."
        ]
      },
      {
        "row": 33,
        "cells": [
          "",
          "KONTAK ESCALATION"
        ]
      },
      {
        "row": 34,
        "cells": [
          "",
          "   • Selisih harian ≤ 2% → lanjut normal"
        ]
      },
      {
        "row": 35,
        "cells": [
          "",
          "   • Selisih 2–5%           → lapor Manager Outlet, tunggu approval"
        ]
      },
      {
        "row": 36,
        "cells": [
          "",
          "   • Selisih > 5%            → lapor Owner langsung malam itu juga"
        ]
      }
    ],
