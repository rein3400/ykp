[
  {
    "id": "inv-login",
    "module": "investor",
    "page": "/login",
    "title": "Login to Investor app",
    "auth": "password",
    "steps": [
      { "do": "goto", "path": "/login" },
      { "do": "fill", "selector": "input[name='username'], input[type='text']", "value": "owner" },
      { "do": "fill", "selector": "input[name='password'], input[type='password']", "value": "owner123" },
      { "do": "click", "selector": "button[type='submit'], button:has-text('Login'), button:has-text('Masuk')", "fallbackSelector": "button[type='submit']" },
      { "do": "waitSettled", "ms": 2000 },
      { "do": "screenshot", "name": "dashboard" }
    ],
    "verify": [
      { "type": "urlMatches", "pattern": "^https://ykp-investor-v1.vercel.app/(investor)?$" },
      { "type": "noErrorText", "selector": "p.text-destructive" }
    ]
  },
  {
    "id": "inv-dashboard-cards",
    "module": "investor",
    "page": "/investor",
    "title": "View dashboard cards",
    "auth": "password",
    "steps": [
      { "do": "goto", "path": "/investor" },
      { "do": "waitSettled", "ms": 1500 },
      { "do": "screenshot", "name": "dashboard-cards" }
    ],
    "verify": [
      { "type": "noErrorText", "selector": "body:has-text('Internal Server Error')" },
      { "type": "noNetwork5xx" }
    ]
  },
  {
    "id": "inv-regenerate-summary",
