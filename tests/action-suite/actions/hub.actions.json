  {
    "id": "hub-theme-toggle",
    "module": "hub",
    "page": "/",
    "title": "Toggle dark/light theme",
    "auth": "hub-form",
    "steps": [
      { "do": "goto", "path": "/" },
      { "do": "click", "selector": "button[aria-label*='theme' i], button:has-text('Dark'), button:has-text('Light')", "fallbackSelector": "button >> nth=0", "timeout": 5000 },
      { "do": "waitSettled", "ms": 500 },
      { "do": "screenshot", "name": "theme-toggled" }
    ],
    "verify": [
      { "type": "noConsoleErrors" }
    ]
  },
  {
    "id": "hub-command-palette",
    "module": "hub",
    "page": "/",
    "title": "Open command palette with Ctrl+K",
    "auth": "hub-form",
    "steps": [
      { "do": "goto", "path": "/" },
      { "do": "press", "key": "Control+k" },
      { "do": "waitSettled", "ms": 500 },
      { "do": "screenshot", "name": "cmd-palette" }
    ],
    "verify": [
      { "type": "noConsoleErrors" }
    ]
  },
  {
    "id": "hub-logout",
    "module": "hub",
    "page": "/",
    "title": "Logout from Hub",
    "auth": "hub-form",
    "steps": [
      { "do": "goto", "path": "/" },
      { "do": "click", "text": "/Logout|Keluar/i", "timeout": 5000 },
      { "do": "waitSettled", "ms": 1500 },
      { "do": "screenshot", "name": "after-logout" }
    ],
    "verify": [
      { "type": "urlMatches", "pattern": "/login" }
    ]
  },
  {
    "id": "hub-login-bad-cred",
    "module": "hub",
    "page": "/login",
    "title": "Login with bad credentials shows error",
    "auth": "hub-form",
    "steps": [
      { "do": "goto", "path": "/login" },
      { "do": "fill", "selector": "input[autocomplete='username']", "value": "owner" },
      { "do": "fill", "selector": "input[autocomplete='current-password']", "value": "wrongpass" },
      { "do": "click", "selector": "button[type='submit']" },
      { "do": "waitSettled", "ms": 1000 },
      { "do": "screenshot", "name": "bad-cred" }
    ],
    "verify": [
      { "type": "errorTextContains", "selector": "p.text-destructive", "text": "Invalid" }
    ]
  }
]
