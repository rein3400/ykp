[
  {
    "id": "hub-login",
    "module": "hub",
    "page": "/login",
    "title": "Login via Hub form",
    "auth": "hub-form",
    "steps": [
      { "do": "goto", "path": "/login" },
      { "do": "fill", "selector": "input[autocomplete='username']", "value": "owner" },
      { "do": "fill", "selector": "input[autocomplete='current-password']", "value": "owner123" },
      { "do": "click", "selector": "button[type='submit']" },
      { "do": "waitSettled", "ms": 2000 },
      { "do": "screenshot", "name": "dashboard" }
    ],
    "verify": [
      { "type": "urlMatches", "pattern": "^https://ykp-hub-production.up.railway.app/?$" },
      { "type": "noErrorText", "selector": "p.text-destructive" }
    ]
  },
  {
    "id": "hub-sso-finance",
    "module": "hub",
    "page": "/",
    "title": "SSO to Finance from Hub",
    "auth": "hub-form",
    "steps": [
      { "do": "goto", "path": "/" },
      { "do": "click", "text": "/Finance|finance/i", "timeout": 10000 },
      { "do": "waitSettled", "ms": 3000 },
      { "do": "screenshot", "name": "finance-via-hub" }
    ],
    "verify": [
      { "type": "noErrorText", "selector": "body:has-text('Internal Server Error')" },
      { "type": "noNetwork5xx" }
    ]
  },
  {
    "id": "hub-sso-hr",
