# ── Module base URLs (server-side fetch targets) ──────────────
YKP_HR_URL=http://localhost:3002
YKP_FINANCE_URL=http://localhost:3003
YKP_WAREHOUSE_URL=http://localhost:3005
YKP_OPS_URL=http://localhost:3007
YKP_INVESTOR_URL=http://localhost:3006

# ── Session ───────────────────────────────────────────────────
# HS256 signing secret for the ykp_owner_session cookie (>= 32 chars)
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# ── Mock mode ─────────────────────────────────────────────────
# true  → serve built-in demo data, login owner/owner123 locally.
# false → fetch live from the sibling modules; mock still auto-activates as
#         a fallback whenever ALL modules are unreachable, so the dashboard
#         always renders something.
YKP_OWNER_MOCK=false
