# YKP Warehouse V1 — Google Sheets DB
# Copy to .env and fill real values. Never commit the real .env.

# Google Cloud service account (shared with ykp-hr-v1)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Spreadsheet ID (shared across all V1 apps)
YKP_WAREHOUSE_SPREADSHEET_ID=
YKP_FINANCE_SPREADSHEET_ID=

DEFAULT_TZ=Asia/Jakarta
SESSION_SECRET=

# Telegram alert delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Environment marker (TESTING / PILOT / PRODUCTION)
ENVIRONMENT=PRODUCTION

# Shared secret for cross-module public reads (owner dashboard / Hermez).
# Sent as x-bot-secret header. Must match the value in owner + hermez.
TELEGRAM_BOT_SECRET=

# Telegram bot username for deep-link (t.me/<username>?start=KODE)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=ykpchataibot
