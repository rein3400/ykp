# Coolify deploy Dockerfile — hermez (plain-TCP internal Postgres support)
# ponytail: sed-patch because packages/schema clients.ts has no env override for ssl.
# Upgrade path: add YKP_DB_PLAIN_TCP handling directly in clients.ts, then delete this file.
# NOTE: build context is the REPO ROOT (Coolify base_directory=/), hence ykp-erp/ prefixes.
FROM node:22-slim AS deps
WORKDIR /repo
COPY ykp-erp/package.json ykp-erp/package-lock.json* ./
COPY ykp-erp/apps/hermez/package.json ./apps/hermez/
RUN npm install --legacy-peer-deps --no-audit

FROM node:22-slim AS builder
WORKDIR /repo
COPY --from=deps /repo/node_modules ./node_modules
COPY ykp-erp/packages ./packages
COPY ykp-erp/apps/hermez ./apps/hermez
COPY --from=deps /repo/apps/hermez/package.json ./apps/hermez/package.json
COPY ykp-erp/tsconfig.json ykp-erp/package.json ykp-erp/package-lock.json* ./
# Re-run npm install in builder stage to set up workspace symlinks
RUN npm install --legacy-peer-deps --no-audit
WORKDIR /repo/apps/hermez
ENV YKP_DATABASE_URL=postgresql://placeholder/db
ENV YKP_MASTER_DATABASE_URL=postgresql://placeholder/db
ENV YKP_HR_DATABASE_URL=postgresql://placeholder/db
ENV YKP_FINANCE_DATABASE_URL=postgresql://placeholder/db
ENV YKP_HERMEZ_DATABASE_URL=postgresql://placeholder/db
WORKDIR /repo
RUN find packages -name 'tsconfig.tsbuildinfo' -delete 2>/dev/null || true \
 && rm -rf packages/ui/dist packages/engine/dist packages/auth/dist packages/config/dist packages/format/dist
RUN sed -i 's|isLocal ? false : "require"|(isLocal || process.env.YKP_DB_PLAIN_TCP === "true") ? false : "require"|' packages/schema/src/db/clients.ts
RUN npm run build --workspace @ykp/config --if-present \
 && npm run build --workspace @ykp/format --if-present \
 && npm run build --workspace @ykp/engine --if-present \
 && npm run build --workspace @ykp/auth --if-present \
 && npm run build --workspace @ykp/ui --if-present
WORKDIR /repo/apps/hermez
RUN npx next build

FROM node:22-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /repo/apps/hermez/.next ./.next
COPY --from=builder /repo/apps/hermez/package.json ./
COPY --from=builder /repo/node_modules ./node_modules
COPY --from=builder /repo/apps/hermez/next.config.mjs ./
COPY --from=builder /repo/packages ./packages
COPY --from=builder /repo/apps/hermez/src/workers ./workers
EXPOSE 3004
# Web server + telegram dialog bot worker, co-located in ONE container.
# Bot is disabled via HERMEZ_BOT_DISABLED env on Coolify until tokens are provided.
CMD ["sh", "-c", "(while true; do node workers/bot-worker.mjs 2>&1; echo '[hermez-bot] exited, restarting in 5s'; sleep 5; done) & PORT=${PORT:-3004} npx next start -p $PORT -H 0.0.0.0"]