{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@finance/*": ["./apps/finance/src/*"],
      "@hr/*": ["./apps/hr/src/*"],
      "@hermez/*": ["./apps/hermez/src/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "exclude": ["node_modules", ".next", "dist"]
}