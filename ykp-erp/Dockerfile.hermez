# Multi-app monorepo Dockerfile — hermez
FROM node:22-slim AS deps
WORKDIR /repo
COPY package.json package-lock.json* ./
COPY apps/hermez/package.json ./apps/hermez/
RUN npm install --legacy-peer-deps --no-audit

FROM node:22-slim AS builder
WORKDIR /repo
COPY --from=deps /repo/node_modules ./node_modules
COPY packages ./packages
COPY apps/hermez ./apps/hermez
COPY --from=deps /repo/apps/hermez/package.json ./apps/hermez/package.json
COPY tsconfig.json package.json package-lock.json* ./
# Re-run npm install in builder stage to set up workspace symlinks
RUN npm install --legacy-peer-deps --no-audit
WORKDIR /repo/apps/hermez
# Build-time env to satisfy schema/db init during page data collection
ENV YKP_DATABASE_URL=postgresql://placeholder/db
ENV YKP_MASTER_DATABASE_URL=postgresql://placeholder/db
ENV YKP_HR_DATABASE_URL=postgresql://placeholder/db
ENV YKP_FINANCE_DATABASE_URL=postgresql://placeholder/db
ENV YKP_HERMEZ_DATABASE_URL=postgresql://placeholder/db
# Build workspace packages in dependency order so dist/ folders exist
# when next build resolves @ykp/* (dist/ is gitignored, so absent in repo).
# config (leaf) -> engine/auth (depend on config) -> ui (depends on format).
# Clear stale tsbuildinfo first to force a fresh tsc compile.
WORKDIR /repo
RUN find packages -name 'tsconfig.tsbuildinfo' -delete 2>/dev/null || true
RUN npm run build --workspace @ykp/config --if-present \
 && npm run build --workspace @ykp/engine --if-present \
 && npm run build --workspace @ykp/auth --if-present \
 && npm run build --workspace @ykp/ui --if-present
WORKDIR /repo/apps/hermez
RUN npx next build

FROM node:22-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /repo/apps/hermez/.next ./.next
COPY --from=builder /repo/apps/hermez/package.json ./
COPY --from=builder /repo/node_modules ./node_modules
COPY --from=builder /repo/apps/hermez/next.config.mjs ./
COPY --from=builder /repo/packages ./packages
COPY --from=builder /repo/apps/hermez/src/workers ./workers
EXPOSE 3004
# Web server + telegram dialog bot worker, co-located in ONE container.
# The worker is the single getUpdates consumer; the web process never polls
# (its manual bot-start is gated by HERMEZ_BOT_WORKER_ENABLED=true, set in the
# Railway env), so there is no two-consumer conflict. Free-plan friendly:
# avoids needing a separate Railway service.
CMD ["sh", "-c", "node workers/bot-worker.cjs & PORT=${PORT:-3004} npx next start -p $PORT -H 0.0.0.0"]
