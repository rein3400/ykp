# Hermez Telegram bot worker — VPS environment
# Copy to /opt/hermez-bot/.env and fill real values. Do NOT commit the real .env.
# Secrets live on Railway Hermez service (ykp-erp-hermez) — copy from there:
#   railway variables --service ykp-erp-hermez --environment production -p 701f7b7d-5fd7-4625-b0fb-435a2d8b6ef7 --kv

# --- Telegram bot (getUpdates long-poll) ---
TELEGRAM_BOT_TOKEN=
HERMEZ_TELEGRAM_BOT_TOKEN=
# Comma-separated list of allowed chat ids. -5437367893 = owner group.
OWNER_CHAT_ID=-5437367893
TELEGRAM_OWNER_CHAT_ID=-5437367893
# Extra allowed private chat ids (e.g. the owner's personal DM with the bot).
OWNER_USER_IDS=5721500978

# --- Hermez WEB data feed ---
# Shared secret the worker sends as x-bot-secret to /api/hermez/bot-data.
HERMEZ_BOT_SECRET=
# IMPORTANT: public WEB URL of the Hermez Railway service. Do NOT use
# 127.0.0.1 here (that points at the VPS itself, not the Railway web app).
HERMEZ_WEB_URL=https://ykp-erp-hermez-production.up.railway.app

# --- LLM (Ollama Cloud) ---
# Docs: https://ollama.com/cloud  |  API base: https://ollama.com/v1
# Get key: ollama.com account → settings. Model list: GET /v1/models
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_BASE_URL=https://ollama.com/v1
LLM_MODEL=glm-5.2

# --- Safety ---
# Leave empty/false. If "true" the worker no-ops (used to disable the bot).
HERMEZ_BOT_DISABLED=