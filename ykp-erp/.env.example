# --- Database URLs (per-DB schema isolation) ---
YKP_MASTER_DATABASE_URL=postgresql://ykp:change-me@localhost:5432/ykp_master
YKP_HR_DATABASE_URL=postgresql://ykp:change-me@localhost:5432/ykp_hr
YKP_FINANCE_DATABASE_URL=postgresql://ykp:change-me@localhost:5432/ykp_finance
YKP_HERMEZ_DATABASE_URL=postgresql://ykp:change-me@localhost:5432/ykp_hermez

# --- Postgres superuser (used by docker-compose) ---
POSTGRES_USER=ykp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# --- Runtime ---
TZ=Asia/Jakarta
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3002

# --- Hermez scheduler ---
HERMEZ_RUN_HOUR_UTC=15
HERMEZ_WRITEBACK_ENABLED=false

# --- Telegram notifications ---
# Bot token from @BotFather. Chat target is a group id (negative), not a private user.
TELEGRAM_BOT_TOKEN=
HERMEZ_TELEGRAM_BOT_TOKEN=
OWNER_CHAT_ID=
TELEGRAM_OWNER_CHAT_ID=

# --- Auth ---
# Session signing secret (>=32 chars) for ykp_session cookie HS256.
NEXTAUTH_SECRET=replace-me-with-random-32-char-secret-or-longer
# Demo SSO / login password for the ERP role-picker apps (finance/hr/hermez).
# Must be set and >=16 chars. Hub should pass this as ?token=... in SSO bridge.
ERP_SSO_SECRET=replace-me-with-random-16-char-secret
CRON_SECRET=replace-me-with-random-32-bytes-hex

# --- Supabase Storage (POS receipt photo upload) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=