# YKP Finance V1 — Google Sheets DB

# Google Cloud service account (Finance app uses this to read/write Sheets)
# 1. Create GCP project -> IAM -> Service Account -> JSON key
# 2. Share the spreadsheet with the service account email (Editor)
# 3. Paste values below (private key with \n escapes)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Spreadsheet ID from the URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
YKP_FINANCE_SPREADSHEET_ID=

# Seed password for the default owner user (sheets:seed-user).
# If omitted, a random 16-character password is generated and printed once.
SEED_PASSWORD=

# Mock mode password. If USE_MOCK_DB=true or Sheets env is missing, the app
# runs on an in-memory demo store. Set MOCK_PASSWORD to control the demo owner
# password; if omitted a random password is generated and logged on first boot.
USE_MOCK_DB=
MOCK_PASSWORD=

# Session signing (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Asia/Jakarta default for all date math
DEFAULT_TZ=Asia/Jakarta

# Optional: force in-memory mock DB even when Sheets env is set (true/false)
USE_MOCK_DB=

# Optional: Telegram alert delivery (leave empty to log deliveries as FAILED without crashing)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Shared secret for the scheduler-called endpoint POST /api/finance/notify/daily-brief.
# Sent as `x-cron-secret: <value>` header. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Environment marker shown in UI and written to audit_log (TESTING / PILOT / PRODUCTION)
ENVIRONMENT=TESTING
