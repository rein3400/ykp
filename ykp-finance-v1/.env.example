# YKP Finance V1 — Google Sheets DB

# Google Cloud service account (Finance app uses this to read/write Sheets)
# 1. Create GCP project -> IAM -> Service Account -> JSON key
# 2. Share the spreadsheet with the service account email (Editor)
# 3. Paste values below (private key with \n escapes)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Spreadsheet ID from the URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
YKP_FINANCE_SPREADSHEET_ID=

# Session signing (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Asia/Jakarta default for all date math
DEFAULT_TZ=Asia/Jakarta

# Optional: force in-memory mock DB even when Sheets env is set (true/false)
USE_MOCK_DB=

# Optional: Telegram alert delivery (leave empty to log deliveries as FAILED without crashing)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Shared secret for the scheduler-called endpoint POST /api/finance/notify/daily-brief.
# Sent as `x-cron-secret: <value>` header. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Environment marker shown in UI and written to audit_log (TESTING / PILOT / PRODUCTION)
ENVIRONMENT=TESTING

# Shared secret for cross-module public reads (owner dashboard / Hermez).
# Sent as x-bot-secret header. Must match the value in owner + hermez.
TELEGRAM_BOT_SECRET=

# Telegram bot username for deep-link (t.me/<username>?start=KODE)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=ykpchataibot

# ── Moka API sync (moka-live-sync) ──────────────────────────────────────
# Master switch: sync endpoint 404s unless true. CSV import stays the only
# ingestion path while false (rollback switch).
MOKA_SYNC_ENABLED=false

# Shared secret for the platform cron calling POST /api/finance/pos/sync.
# Sent as `x-moka-sync-secret` header. Generate like CRON_SECRET.
MOKA_SYNC_SECRET=

# Comma-separated outlet keys; each key needs the three vars below.
# Example keys: SEKARPIZZA_TIRTODIPURAN, FUNKYDAK_COLOMBO, SUBURBUNS_COLOMBO
MOKA_OUTLETS=
MOKA_<KEY>_CLIENT_ID=
MOKA_<KEY>_CLIENT_SECRET=
MOKA_<KEY>_OUTLET_ID=

# Optional override (default https://api.mokapos.com)
MOKA_API_BASE=

# Redirect URI registered on each Moka app (consent lands here after Allow).
# Production: https://<finance-host>/api/finance/pos/sync/authorize/callback
MOKA_REDIRECT_URI=
