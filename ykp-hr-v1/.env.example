# YKP HR V1 — Google Sheets DB

# Google Cloud service account (HR app uses this to read/write Sheets)
# 1. Create GCP project -> IAM -> Service Account -> JSON key
# 2. Share the spreadsheet with the service account email (Editor)
# 3. Paste the JSON key content (escaped) below OR set GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Spreadsheet ID from the URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
YKP_HR_SPREADSHEET_ID=

# Seed password for the default owner user (sheets:seed-user).
# If omitted, a random 16-character password is generated and printed once.
SEED_PASSWORD=

# Optional: force in-memory mock DB even when Sheets env is set (true/false).
# When Sheets env is missing/empty, the mock DB activates automatically —
# every page and API then runs offline on seeded demo data.
# Set MOCK_PASSWORD to control the demo owner password; if omitted a random
# password is generated and logged on first boot.
USE_MOCK_DB=
MOCK_PASSWORD=

# Session signing (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_me_with_64_hex

# Asia/Jakarta default for all date math
DEFAULT_TZ=Asia/Jakarta

# Optional: Telegram alert delivery — HIGH/CRITICAL alerts + 22:00 WIB daily brief.
# Leave empty to log deliveries as FAILED without crashing the request path.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Shared secret for the scheduler-called endpoint POST /api/hr/notify/daily-brief.
# Sent as `x-cron-secret: <value>` header. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
