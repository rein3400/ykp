# YKP HR V1 — Google Sheets DB

# Google Cloud service account (HR app uses this to read/write Sheets)
# 1. Create GCP project -> IAM -> Service Account -> JSON key
# 2. Share the spreadsheet with the service account email (Editor)
# 3. Paste the JSON key content (escaped) below OR set GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Spreadsheet ID from the URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
YKP_HR_SPREADSHEET_ID=

# Optional: force in-memory mock DB even when Sheets env is set (true/false).
# When Sheets env is missing/empty, the mock DB activates automatically —
# every page and API then runs offline on seeded demo data (owner/owner123, hradmin/hradmin123).
USE_MOCK_DB=

# Session signing (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_me_with_64_hex

# Asia/Jakarta default for all date math
DEFAULT_TZ=Asia/Jakarta

# Optional: Telegram alert delivery — HIGH/CRITICAL alerts + 22:00 WIB daily brief.
# Leave empty to log deliveries as FAILED without crashing the request path.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram attendance webhook POST /api/hr/attendance/telegram.
# Sent by Telegram as `X-Telegram-Bot-Api-Secret-Token: <value>` header; the route
# rejects requests whose token does not match. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# Shared secret for the scheduler-called endpoint POST /api/hr/notify/daily-brief.
# Sent as `x-cron-secret: <value>` header. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# MOM 1 Sep 2026 — payroll cross-app wiring (HR ↔ Finance).
# HR generate POSTs here best-effort after writing Ready-to-Pay rows.
FINANCE_NOTIFY_URL=http://localhost:3003/api/finance/payroll/hr-notify
# Shared secret for Finance → HR calls (needs-revision, finance-notify) via
# `x-finance-secret` header. Must match FINANCE_NOTIFY_SECRET on the Finance
# app. HR_NOTIFY_SECRET is accepted as an alias on both sides.
FINANCE_NOTIFY_SECRET=
# HR_NOTIFY_SECRET=

# MOM 1 Sep 2026 item 5 — SMTP pengirim slip gaji (1 email pengirim).
# Tanpa ini, POST /api/hr/payslip/send menjawab 503 (tidak pernah fake-kirim).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
